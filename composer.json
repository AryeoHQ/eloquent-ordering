{
    "name": "aryeo/eloquent-ordering",
    "description": "Manually ordered Eloquent collections stored as fractional rank keys",
    "type": "library",
    "license": "MIT",
    "repositories": {
        "artifactory": {
            "type": "composer",
            "url": "https://artifactory.zgtools.net/artifactory/api/composer/listing-and-vendor-management-composer/",
            "only": [
                "aryeo/*",
                "zillow/*"
            ]
        }
    },
    "require": {
        "php": "^8.5",
        "laravel/framework": "^12.37 || ^13",
        "aryeo/eloquent-concurrency": "^0.0.3",
        "aryeo/tooling-laravel": "0.0.43"
    },
    "require-dev": {
        "ext-pdo": "*",
        "orchestra/testbench": "^10.6 || ^11",
        "orchestra/testbench-core": "^10.7 || ^11",
        "phpunit/phpunit": "^12.4.1 || ^13"
    },
    "autoload": {
        "psr-4": {
            "Support\\": "src/Support/",
            "Tooling\\": "src/Tooling/"
        },
        "exclude-from-classmap": [
            "*Test.php",
            "*TestCases.php",
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Justin Seliga",
            "email": "justinsel@zillowgroup.com"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "aryeo/tooling-laravel": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Support\\Database\\Eloquent\\Ordering\\Providers\\Provider"
            ]
        },
        "tooling": {
            "rector": {
                "config": {
                    "paths": [
                        "src"
                    ]
                },
                "configured_rules": "tooling/rector/configured-rules.php"
            },
            "phpstan": {
                "config": {
                    "paths": [
                        "src",
                        "tests",
                        "workbench"
                    ]
                },
                "rules": "tooling/phpstan/rules.neon"
            },
            "pint": {
                "config": {
                    "paths": [
                        "src",
                        "tests",
                        "workbench"
                    ]
                }
            }
        }
    }
}
